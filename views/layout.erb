<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>rehash<%= @title ? " — #{@title}" : "" %></title>
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="alternate" type="application/rss+xml" title="rehash"
          href="<%= @community && @community != 'all' ? "/r/#{@community}/feed.xml" : '/feed.xml' %>">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">rehash</a>
      <nav class="communities">
        <a href="/" class="<%= 'active' if @community.nil? %>">all</a>
        <% @communities.each do |row| %>
          <a href="<%= community_path(row['community']) %>"
             class="<%= 'active' if @community == row['community'] %>">r/<%= h row["community"] %></a>
        <% end %>
      </nav>
      <form class="search" action="<%= @community ? "/r/#{@community}" : '/' %>" method="get">
        <input type="search" name="q" value="<%= h @query %>" placeholder="search headlines" aria-label="Search">
      </form>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer>
      <span><%= @stats[:posts] %> links from <%= @stats[:sources] %> sources ·
        <%= @stats[:votes] %> votes ·
        rewriter: <code><%= h Rehash.rewriter.name %></code></span>
      <span><a href="/about">about</a> · <a href="/feed.xml">rss</a></span>
    </footer>
    <script src="/app.js" defer></script>
  </body>
</html>
